{
  "name": "@zeroman.yang/react-auto-components-devtools",
  "version": "0.5.4",
  "description": "Agent developer tools for React Auto Components: page discovery, inspection and targeted browser control.",
  "type": "module",
  "license": "MIT",
  "author": "Zeroman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zeroman/react-auto-components.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "bin": {
    "rac": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@zeroman.yang/react-auto-components": "0.5.4",
    "vite": ">=6 <9",
    "playwright": ">=1.50 <2"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "playwright": "^1.63.0",
    "@zeroman.yang/react-auto-components": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
